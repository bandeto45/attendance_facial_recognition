<template>
  <div class="empty-state">
    <div class="empty-state__icon-wrap">
      <i class="material-icons empty-state__icon">${icon}</i>
    </div>
    <div class="empty-state__title">${title}</div>
    <div class="empty-state__message">${message}</div>
    ${actionText ? $h`
      <button class="button button-fill empty-state__action" @click=${onAction}>
        ${actionText}
      </button>
    ` : ''}
  </div>
</template>

<script>
/**
 * EmptyState - Empty state placeholder component
 * 
 * Props:
 * - icon (string): Material icon name
 * - title (string): Empty state title
 * - message (string): Empty state message
 * - actionText (string): Action button text (optional)
 * - onAction (function): Action button callback (optional)
 */
export default (props) => {
  const { 
    icon = 'inbox',
    title = 'No Data',
    message = 'Nothing to display here yet.',
    actionText = null,
    onAction = null
  } = props;
  
  return $render;
}
</script>

