<template>
  <div class="page recognition-page" data-name="recognition">
    <!-- Navbar -->
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a href="#" class="link icon-only" @click=${handleLogout}>
            <i class="icon material-icons">logout</i>
          </a>
        </div>
        <div class="title">Live Recognition</div>
        <div class="right">
          ${isAdmin ? $h`
            <a href="#" class="link icon-only" @click=${openScheduleSettings}>
              <i class="icon material-icons">schedule</i>
            </a>
          ` : ''}
          <span class="role-badge ${isAdmin ? 'role-admin' : 'role-operator'}">${isAdmin ? 'ADMIN' : 'OPERATOR'}</span>
        </div>
      </div>
    </div>

    <!-- Page Content -->
    <div class="page-content">

      <!-- Live Clock -->
      <div class="clock-card">
        <div class="clock-time">${currentTime}</div>
        <div class="clock-date">${currentDate}</div>
      </div>

      <!-- Schedule Status Strip -->
      ${scheduleSettings.timeIn ? $h`
        <div class="schedule-strip">
          <div class="schedule-strip__item">
            <i class="icon material-icons schedule-strip__icon">login</i>
            <span class="schedule-strip__label">On-Time From</span>
            <span class="schedule-strip__value">${scheduleSettings.timeIn}</span>
          </div>
          <div class="schedule-strip__divider"></div>
          <div class="schedule-strip__item">
            <i class="icon material-icons schedule-strip__icon">schedule</i>
            <span class="schedule-strip__label">Late After</span>
            <span class="schedule-strip__value">${scheduleSettings.lateAfter}</span>
          </div>
          <div class="schedule-strip__divider"></div>
          <div class="schedule-strip__item">
            <span class="schedule-strip__label">Now</span>
            <span class="schedule-status schedule-status--${currentStatusType}">${currentStatusLabel}</span>
          </div>
        </div>
      ` : ''}

      <!-- Action Buttons -->
      <div class="recognition-actions-header">
        <button class="icon-selection-btn ${manualMode === 'in' ? 'icon-selection-btn--active' : ''}" @click=${() => startManual('in')}>
          <i class="icon material-icons icon-lg">login</i>
          <span class="icon-label">Time In</span>
        </button>
        <button class="icon-selection-btn icon-selection-btn--out ${manualMode === 'out' ? 'icon-selection-btn--active-out' : ''}" @click=${() => startManual('out')}>
          <i class="icon material-icons icon-lg">logout</i>
          <span class="icon-label">Time Out</span>
        </button>
      </div>

      <!-- Recent Attendance Feed -->
      <div class="block-title mt-3">
        Today's Activity 
        <span class="recent-count">${recentAttendance.length}</span>
      </div>
      <div class="block">
        ${recentAttendance.length === 0 ? $h`
          <div class="empty-feed">
            <i class="icon material-icons">event_note</i>
            <p>No activity recorded today yet</p>
          </div>
        ` : recentAttendance.map(r => $h`
          <div class="feed-item feed-item--${r.status}">
            <div class="feed-item__icon">
              <i class="icon material-icons">${r.status === 'in' ? 'login' : 'logout'}</i>
            </div>
            <div class="feed-item__info">
              <div class="feed-item__name">${r.name}</div>
              <div class="feed-item__time">${r.time}</div>
            </div>
            <div class="feed-item__badge badge-${r.status === 'in' ? 'success' : 'error'}">
              ${r.status === 'in' ? 'IN' : 'OUT'}
            </div>
          </div>
        `)}
      </div>

    </div>

    <!-- Bottom Toolbar -->
    <${BottomToolbar} active-tab="recognition" />
  </div>
</template>

<script>
import BottomToolbar from '../components/BottomToolbar.f7';
import db from '../js/utils/database.js';

export default (props, { $f7, $on, $onMounted, $onBeforeUnmount, $update, $h }) => {
  let isCordova = !!window.cordova;
  let currentDate = '';
  let currentTime = '';
  let recognitionStatus = '';
  let recentAttendance = [];
  let timeInterval = null;
  let manualMode = '';

  // Schedule settings state
  let scheduleSettings = { timeIn: '', lateAfter: '' };
  let currentStatusLabel = '—';   // 'EARLY' | 'ON TIME' | 'LATE' | '—'
  let currentStatusType  = '';    // 'early' | 'present' | 'late' | ''

  // Read role from session
  let isAdmin = false;
  try {
    const u = localStorage.getItem('user');
    if (u) isAdmin = JSON.parse(u).role === 'admin';
  } catch (e) { /* ignore */ }

  const lastSeenMap = new Map();
  const DUP_WINDOW_MS = 30000; // 30s duplicate suppression

  // ── Compute what status a time-in RIGHT NOW would get ────────────────────
  const computeScheduleStatus = () => {
    const { timeIn, lateAfter } = scheduleSettings;
    if (!timeIn || !lateAfter) {
      currentStatusLabel = '—';
      currentStatusType  = '';
      return;
    }
    const now = new Date();
    const current  = now.getHours() * 60 + now.getMinutes();
    const [iH, iM] = timeIn.split(':').map(Number);
    const [lH, lM] = lateAfter.split(':').map(Number);
    const onTime   = iH * 60 + iM;
    const lateAt   = lH * 60 + lM;
    if      (current < onTime)  { currentStatusLabel = 'EARLY';   currentStatusType = 'early';   }
    else if (current > lateAt)  { currentStatusLabel = 'LATE';    currentStatusType = 'late';    }
    else                        { currentStatusLabel = 'ON TIME'; currentStatusType = 'present'; }
  };

  // ── Load schedule from DB ─────────────────────────────────────────────────
  const loadSchedule = async () => {
    try {
      scheduleSettings = await db.getScheduleSettings();
      computeScheduleStatus();
      $update();
    } catch (e) {
      console.warn('Could not load schedule settings:', e);
    }
  };

  const updateTime = () => {
    const now = new Date();
    currentDate = now.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });
    currentTime = now.toLocaleTimeString('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit'
    });
    // Recompute live schedule status every second
    computeScheduleStatus();
    $update();
  };

  const handleLogout = () => {
    $f7.dialog.confirm('Are you sure you want to logout?', 'Logout', () => {
      localStorage.removeItem('user');
      $f7.views.main.router.navigate('/', { reloadCurrent: true });
    });
  };

  const loadRecentAttendance = () => {
    db.getTodayAttendance()
      .then((rows) => {
        // Build flat list: separate entry for each time-in and time-out
        const feed = [];
        rows.forEach(r => {
          const name = `${r.first_name || ''} ${r.last_name || ''}`.trim() || r.student_id;
          if (r.time_in) {
            feed.push({ name, studentId: r.student_id, time: r.time_in, status: 'in', sortKey: r.time_in });
          }
          if (r.time_out) {
            feed.push({ name, studentId: r.student_id, time: r.time_out, status: 'out', sortKey: r.time_out });
          }
        });
        // Sort most recent first
        feed.sort((a, b) => b.sortKey.localeCompare(a.sortKey));
        recentAttendance = feed.slice(0, 20);
        $update();
      })
      .catch((err) => {
        console.error('Load attendance error:', err);
      });
  };

  // Reload data every time the page becomes visible (e.g. returning from camera)
  $on('pageBeforeIn', () => {
    loadRecentAttendance();
    loadSchedule();  // picks up any schedule changes saved in settings dialog
  });

  const startManual = async (mode) => {
    manualMode = mode;
    recognitionStatus = '';
    $f7.views.main.router.navigate(`/camera/${mode}/`);
  };

  // ── Schedule Settings (admin only) ────────────────────────────────────────
  const openScheduleSettings = async () => {
    await db.init();
    const s = await db.getScheduleSettings();
    $f7.dialog.create({
      title: 'Schedule Settings',
      content: `
        <div style="padding:8px 4px 0;">
          <p style="font-size:12px;color:#888;margin:0 0 14px;">
            Only the <strong>first</strong> time-in each day is evaluated against these times.
          </p>
          <label style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;">On-Time From</label>
          <input id="sched-time-in" type="time" value="${s.timeIn}"
            style="width:100%;padding:8px 10px;border:1.5px solid #e0e0e0;border-radius:8px;font-size:16px;margin-bottom:14px;box-sizing:border-box;"/>
          <label style="font-size:13px;font-weight:600;display:block;margin-bottom:4px;">Late After</label>
          <input id="sched-late-after" type="time" value="${s.lateAfter}"
            style="width:100%;padding:8px 10px;border:1.5px solid #e0e0e0;border-radius:8px;font-size:16px;box-sizing:border-box;"/>
          <p style="font-size:11px;color:#999;margin:8px 0 0;">
            Before On-Time = <b>Early</b> &nbsp;·&nbsp; Within window = <b>Present</b> &nbsp;·&nbsp; After Late After = <b>Late</b>
          </p>
        </div>
      `,
      buttons: [
        { text: 'Cancel', color: 'red' },
        {
          text: 'Save',
          bold: true,
          onClick: async () => {
            const ti = document.getElementById('sched-time-in').value;
            const la = document.getElementById('sched-late-after').value;
            if (!ti || !la) {
              $f7.toast.create({ text: 'Please fill both times', position: 'center', closeTimeout: 2000 }).open();
              return;
            }
            if (la <= ti) {
              $f7.toast.create({ text: '"Late After" must be later than "On-Time From"', position: 'center', closeTimeout: 2500 }).open();
              return;
            }
            await db.setSetting('schedule_time_in', ti);
            await db.setSetting('schedule_late_after', la);
            await loadSchedule(); // refresh live strip immediately
            $f7.toast.create({
              text: `✅ Schedule saved — on-time: ${ti}, late after: ${la}`,
              position: 'center',
              closeTimeout: 2500
            }).open();
          }
        }
      ]
    }).open();
  };

  $onMounted(async () => {
    isCordova = !!window.cordova;
    
    // Check authentication
    const user = localStorage.getItem('user');
    if (!user) {
      $f7.views.main.router.navigate('/', { reloadCurrent: true });
      return;
    }

    // Wait for Cordova to be ready if in Cordova environment
    if (window.cordova) {
      if (!window.sqlitePlugin && !window.SQLitePlugin) {
        console.log('Waiting for Cordova plugins to load...');
        await new Promise((resolve) => {
          document.addEventListener('deviceready', resolve, { once: true });
        });
        // Give extra time for plugins to fully initialize
        await new Promise((resolve) => setTimeout(resolve, 500));
      }
    }

    updateTime();
    timeInterval = setInterval(updateTime, 1000);
    await loadSchedule();
    loadRecentAttendance();
  });

  $onBeforeUnmount(() => {
    if (timeInterval) {
      clearInterval(timeInterval);
    }
  });

  return $render;
};
</script>

<style scoped>
.navbar {
  --f7-navbar-bg-color: var(--attendance-primary);
  --f7-navbar-text-color: white;
  --f7-navbar-link-color: white;
