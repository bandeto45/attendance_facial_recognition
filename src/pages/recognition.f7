  font-size: var(--font-sm);
  font-weight: 500;
  opacity: 0.85;
  margin-top: var(--space-2);
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* Schedule Status Strip */
.schedule-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  border-radius: var(--radius-md);
  margin: 0 var(--space-3) var(--space-2);
  padding: var(--space-2) var(--space-3);
  box-shadow: 0 2px 8px rgba(0,0,0,0.07);
  border: 1px solid #f0f0f0;
}

.schedule-strip__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  flex: 1;
}

.schedule-strip__icon {
  font-size: 16px;
  color: var(--attendance-primary);
}

.schedule-strip__label {
  font-size: 10px;
  color: #aaa;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.schedule-strip__value {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--attendance-secondary);
  letter-spacing: 0.5px;
}

.schedule-strip__divider {
  width: 1px;
  height: 36px;
  background: #eee;
  flex-shrink: 0;
}

/* Live status pill */
.schedule-status {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  text-transform: uppercase;
}

.schedule-status--early {
  background: rgba(33, 150, 243, 0.12);
  color: #2196F3;
}

.schedule-status--present {
  background: rgba(76, 175, 80, 0.15);
  color: var(--attendance-primary);
}

.schedule-status--late {
  background: rgba(244, 67, 54, 0.12);
  color: var(--attendance-error, #F44336);
}

.schedule-status-- {
  background: #f5f5f5;
  color: #aaa;
}

/* Action buttons */
.recognition-actions-header {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
  padding: var(--space-3) var(--space-4);
  justify-content: center;
}

.icon-selection-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-5) var(--space-7);
  border-radius: var(--radius-xl);
  border: 2px solid rgba(76, 175, 80, 0.25);
  background: rgba(76, 175, 80, 0.06);
  color: var(--attendance-secondary);
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  min-width: 130px;
}

.icon-selection-btn--out {
  border-color: rgba(255, 87, 34, 0.25);
  background: rgba(255, 87, 34, 0.06);
}

.icon-lg {
  font-size: 48px;
  display: block;
}

.icon-label {
  font-size: var(--font-sm);
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.icon-selection-btn:active {
  transform: scale(0.95);
}

.icon-selection-btn--active {
  background: linear-gradient(135deg, var(--attendance-primary) 0%, #388e3c 100%);
  border-color: var(--attendance-primary);
  color: white;
  box-shadow: 0 8px 24px rgba(76, 175, 80, 0.4);
}

.icon-selection-btn--active-out {
  background: linear-gradient(135deg, var(--attendance-accent) 0%, #bf360c 100%);
  border-color: var(--attendance-accent);
  color: white;
  box-shadow: 0 8px 24px rgba(255, 87, 34, 0.4);
}

.icon-selection-btn--active .icon-lg,
.icon-selection-btn--active-out .icon-lg {
  animation: iconPulse 0.6s ease-out;
}

@keyframes iconPulse {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

/* Recent attendance feed */
.block-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.recent-count {
  background: var(--attendance-primary);
  color: white;
  border-radius: var(--radius-full);
  font-size: 11px;
  font-weight: 700;
  padding: 1px 7px;
  min-width: 20px;
  text-align: center;
}

.empty-feed {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-7) var(--space-4);
  color: #aaa;
  gap: var(--space-2);
}

.empty-feed .material-icons {
  font-size: 48px;
  opacity: 0.4;
}

.empty-feed p {
  font-size: var(--font-sm);
  margin: 0;
}

.feed-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3);
  background: white;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-2);
  box-shadow: 0 2px 6px rgba(0,0,0,0.07);
  border-left: 4px solid transparent;
  transition: transform 0.2s ease;
}

.feed-item--in {
  border-left-color: var(--attendance-primary);
}

.feed-item--out {
  border-left-color: var(--attendance-accent);
}

.feed-item__icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feed-item--in .feed-item__icon {
  background: rgba(76, 175, 80, 0.12);
  color: var(--attendance-primary);
}

.feed-item--out .feed-item__icon {
  background: rgba(255, 87, 34, 0.12);
  color: var(--attendance-accent);
}

.feed-item__info {
  flex: 1;
  min-width: 0;
}

.feed-item__name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--attendance-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feed-item__time {
  font-size: var(--font-sm);
  color: #888;
  margin-top: 2px;
}

.feed-item__badge {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.badge-success {
  background: rgba(76, 175, 80, 0.15);
  color: var(--attendance-primary);
}

.badge-error {
  background: rgba(255, 87, 34, 0.15);
  color: var(--attendance-accent);
}

.mt-3 {
  margin-top: var(--space-3);
}
</style>
